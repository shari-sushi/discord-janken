{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run register-commands && next build",
    "register-commands": "npx tsx app/api/discord/_command/register.ts",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:unit": "vitest run --testNamePattern=\"^((?!integration).)*$\"",
    "test:integration": "vitest run --testNamePattern=\"integration\"",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@upstash/qstash": "^2.9.0",
    "discord-api-types": "^0.38.42",
    "discord-interactions": "^4.4.0",
    "dotenv": "^17.2.3",
    "googleapis": "^171.4.0",
    "next": "16.1.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "redis": "^5.10.0",
    "uuidv4": "^6.2.13",
    "vercel": "^50.9.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/ui": "^4.0.18",
    "eslint": "^9",
    "eslint-config-next": "16.1.5",
    "happy-dom": "^20.6.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
