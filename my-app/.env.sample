
# Discord
DISCORD_PUBLIC_KEY=xxx
DISCORD_APPLICATION_ID=xxx
DISCORD_BOT_TOKEN=xxx
DISCORD_WEB_HOOK_URL=xxx

# 認証
ALLOWED_USERS=xxx
ADMIN_PASSWORD=xxx
WEB_API_SECRET=xxx
# スクリム調整: チームを作成できる Discord ユーザーID（カンマ区切り・省略可）
TEAM_SCHEDULE_CREATOR_DISCORD_IDS=123456789012345678,234567890123456789

# Redis
REDIS_URL=xxx

# PostgreSQL（Neon）スクリム調整機能用。pooled 接続文字列を推奨
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Google Sheets
GOOGLE_SERVICE_ACCOUNT_JSON=xxx
GOOGLE_SHEET_URL=xxx

# アプリURL
APP_URL=http://localhost:3000

# QStash
QSTASH_URL=xxx
QSTASH_TOKEN=xxx
QSTASH_CURRENT_SIGNING_KEY=xxx
QSTASH_NEXT_SIGNING_KEY=xxx

# Riot API（今回追加）
RIOT_API_KEY=xxx
RIOT_API_REVALIDATE_SECONDS=xxx

# PostgreSQL on Neon
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/team_schedules
